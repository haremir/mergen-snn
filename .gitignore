# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so
*.pyd

# Distribution / packaging
build/
dist/
eggs/
.eggs/
*.egg-info/
*.egg

# Virtual environments
.venv/
.venv-directml/
venv/
ENV/
env/

# Testing & caches
.pytest_cache/
.coverage
htmlcov/

# Jupyter Notebook
.ipynb_checkpoints

# IDEs & OS files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Project checkpoints & data (keep .gitkeep tracked)
checkpoints/*
!checkpoints/.gitkeep

data/raw/*
!data/raw/.gitkeep

data/processed/*
!data/processed/.gitkeep

# Ensure uv.lock is committed
!uv.lock
